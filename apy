@app.route('/audio/<path:filename>')
def serve_audio(filename):
    return send_from_directory('audio', filename)

@app.route('/chat', methods=['POST'])
def chat():
    texto = request.json.get('msg', '').lower()
    fecha, hora = get_tiempo()
    
    # Lógica de respuesta base
    if "fecha" in texto:
        respuesta = f"Hoy es {fecha}."
    elif "hora" in texto:
        respuesta = f"La hora actual en Guayaquil es {hora}."
    else:
        respuesta = "He recibido tu mensaje: " + texto

    # Generación de voz
    try:
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        loop.run_until_complete(edge_tts.Communicate(respuesta, "es-ES-ElviraNeural").save("audio/resp.mp3"))
    except Exception as e:
        print(f"Error generando audio: {e}")
        
    return jsonify({"response": respuesta})

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
